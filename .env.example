# .env.example

# Server
PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# Persistent storage (set to the mount path of your persistent disk on Render)
DATA_DIR=./data

# Admin
ADMIN_USER=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe

# Stripe (leave empty to use demo mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (leave empty to use demo mode)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox

# SMTP (optional; required to send order confirmation emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: receive a copy of new orders
ORDER_NOTIFY_EMAIL=
